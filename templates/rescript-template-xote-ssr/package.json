{
  "name": "rescript-template-xote-ssr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "res:build": "rescript",
    "res:clean": "rescript clean",
    "res:dev": "rescript -w",
    "dev": "node server.mjs",
    "start": "node server.mjs --production",
    "build": "npm run build:client && npm run build:ssr",
    "build:client": "vite build --outDir dist/client",
    "build:ssr": "vite build --ssr src/Server.res.mjs --outDir dist/server"
  },
  "dependencies": {
    "xote": "^7.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "xote"
    ]
  },
  "trustedDependencies": [
    "xote"
  ]
}
